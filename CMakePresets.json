    ],
    "testPresets": [
        {
            "name": "Test-Base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        },
        {
            "name": "Apple-Debug",
            "inherits": "Test-Base",
            "configurePreset": "Apple-Debug"
        },
        {
            "name": "Apple-Release",
            "inherits": "Test-Base",
            "configurePreset": "Apple-Release"
        },
        {
            "name": "Darwin-Clang-Debug",
            "inherits": "Test-Base",
            "configurePreset": "Darwin-Clang-Debug"
        },
        {
            "name": "Darwin-Clang-Release",
            "inherits": "Test-Base",

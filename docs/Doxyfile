# Doxyfile for sip2json
PROJECT_NAME           = "sip2json"
PROJECT_BRIEF          = "A SIP Parser for Modern C++"
OUTPUT_DIRECTORY       = docs
INPUT                  = include/siddiqsoft
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.h
EXCLUDE_PATTERNS       = */tests/* */benchmarks/* */build/*

GENERATE_XML           = YES
XML_OUTPUT             = doxygen_xml
XML_PROGRAMLISTING     = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = doxygen_html
GENERATE_LATEX         = NO
GENERATE_MAN            = NO
GENERATE_RTF            = NO

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
DOT_CLEANUP            = NO
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 50
CLASS_DIAGRAMS         = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DIRECTORY_GRAPH        = YES
DOT_GRAPH_MAX_NODES    = 100
DOT_TRANSPARENT        = YES

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
SEARCH_INCLUDES        = YES
BUILTIN_STL_SUPPORT    = YES

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

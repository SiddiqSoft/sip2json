<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  
  <!-- Visualization for sipmessage class -->
  <Type Name="siddiqsoft::sipmessage">
    <DisplayString Condition="this-&gt;contains(&quot;s&quot;) &amp;&amp; (*this)[&quot;s&quot;].contains(&quot;method&quot;)">
      SIP Request {(*this)[&quot;s&quot;][&quot;method&quot;]} {(*this)[&quot;s&quot;][&quot;uri&quot;]}
    </DisplayString>
    <DisplayString Condition="this-&gt;contains(&quot;s&quot;) &amp;&amp; (*this)[&quot;s&quot;].contains(&quot;status&quot;)">
      SIP Response {(*this)[&quot;s&quot;][&quot;status&quot;]} {(*this)[&quot;s&quot;][&quot;reason&quot;]}
    </DisplayString>
    <DisplayString Condition="this-&gt;contains(&quot;s&quot;) &amp;&amp; (*this)[&quot;s&quot;].contains(&quot;type&quot;)">
      {(*this)[&quot;s&quot;][&quot;type&quot;] == 1 ? "SIP Request" : "SIP Response"}
    </DisplayString>
    <DisplayString>SIP Message (empty)</DisplayString>
    <Expand HideRawView="true">
      <Item Name="[Type]" Condition="this-&gt;contains(&quot;s&quot;) &amp;&amp; (*this)[&quot;s&quot;].contains(&quot;type&quot;)">
        (*this)[&quot;s&quot;][&quot;type&quot;] == 1 ? "Request" : "Response"
      </Item>
      <Item Name="[Method]" Condition="this-&gt;contains(&quot;s&quot;) &amp;&amp; (*this)[&quot;s&quot;].contains(&quot;method&quot;)">
        (*this)[&quot;s&quot;][&quot;method&quot;]
      </Item>
      <Item Name="[URI]" Condition="this-&gt;contains(&quot;s&quot;) &amp;&amp; (*this)[&quot;s&quot;].contains(&quot;uri&quot;)">
        (*this)[&quot;s&quot;][&quot;uri&quot;]
      </Item>
      <Item Name="[Status Code]" Condition="this-&gt;contains(&quot;s&quot;) &amp;&amp; (*this)[&quot;s&quot;].contains(&quot;status&quot;)">
        (*this)[&quot;s&quot;][&quot;status&quot;]
      </Item>
      <Item Name="[Reason]" Condition="this-&gt;contains(&quot;s&quot;) &amp;&amp; (*this)[&quot;s&quot;].contains(&quot;reason&quot;)">
        (*this)[&quot;s&quot;][&quot;reason&quot;]
      </Item>
      <Item Name="[Version]" Condition="this-&gt;contains(&quot;s&quot;) &amp;&amp; (*this)[&quot;s&quot;].contains(&quot;version&quot;)">
        (*this)[&quot;s&quot;][&quot;version&quot;]
      </Item>
      <Item Name="[Headers]" Condition="this-&gt;contains(&quot;h&quot;)">
        (*this)[&quot;h&quot;]
      </Item>
      <Item Name="[Body]" Condition="this-&gt;contains(&quot;b&quot;)">
        (*this)[&quot;b&quot;]
      </Item>
      <Item Name="[Metadata]" Condition="this-&gt;contains(&quot;meta&quot;)">
        (*this)[&quot;meta&quot;]
      </Item>
      <Item Name="[Raw JSON]">
        *(nlohmann::json*)this
      </Item>
    </Expand>
  </Type>

  <!-- Visualization for sip2json class (static utility class) -->
  <Type Name="siddiqsoft::sip2json">
    <DisplayString>sip2json (C++20 Zero-Copy SIP Parser)</DisplayString>
    <Expand HideRawView="true">
      <Item Name="[Description]">
        "Static C++20 utility class for SIP message parsing and serialization"
      </Item>
      <Item Name="[Typical Message Size]">
        3072
      </Item>
    </Expand>
  </Type>

  <!-- Visualization for SIPMessageType enum -->
  <Type Name="siddiqsoft::SIPMessageType">
    <DisplayString Condition="*this == 1">request</DisplayString>
    <DisplayString Condition="*this == 2">response</DisplayString>
    <DisplayString>notspecified</DisplayString>
  </Type>

  <!-- Visualization for sip2jsonErrors enum -->
  <Type Name="siddiqsoft::sip2jsonErrors">
    <DisplayString Condition="*this == 0">ok (0)</DisplayString>
    <DisplayString Condition="*this == 1">incomplete_buffer_for_parse (1)</DisplayString>
    <DisplayString Condition="*this == 2">incomplete_buffer_for_content (2)</DisplayString>
    <DisplayString Condition="*this == 3">incomplete_buffer_for_header (3)</DisplayString>
    <DisplayString Condition="*this == 4">invalid_startline (4)</DisplayString>
    <DisplayString Condition="*this == 5">unsupported_contenttype (5)</DisplayString>
    <DisplayString Condition="*this == 6">missing_required_element (6)</DisplayString>
    <DisplayString Condition="*this == 7">invalid_document (7)</DisplayString>
    <DisplayString Condition="*this == 8">invalid_document_unsupported_method (8)</DisplayString>
    <DisplayString Condition="*this == 9">invalid_document_unsupported_content (9)</DisplayString>
    <DisplayString Condition="*this == 10">empty_message (10)</DisplayString>
    <DisplayString Condition="*this == 0xFFFFFFFF">unknown (0xFFFFFFFF)</DisplayString>
    <DisplayString>unknown</DisplayString>
  </Type>

  <!-- Visualization for sip2json_exception and derived hierarchy -->
  <Type Name="siddiqsoft::sip2json_exception" Inheritable="true">
    <DisplayString>{errCode}</DisplayString>
    <Expand HideRawView="true">
      <Item Name="[Error Code]">errCode</Item>
      <Item Name="[Message]">(std::exception*)this,view(simple)</Item>
    </Expand>
  </Type>

</AutoVisualizer>

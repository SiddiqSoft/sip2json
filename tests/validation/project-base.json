{
    "version": 8,
    "configurePresets": [
        {
            "name": "Project-Base",
            "displayName": "Project Base",
            "description": "Base preset containing project-specific configurations and cache variables.",
            "cacheVariables": {
                "SIP2JSON_VERSION": "current",
                "CI_BUILDID": "0.0.0",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            },
            "hidden": true
        }
    ]
}
